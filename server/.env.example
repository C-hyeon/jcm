# ─── 서버 ───
PORT=8787
NODE_ENV=development
# 프론트엔드 도메인만 허용(쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# ─── Firebase ───
FIREBASE_PROJECT_ID=jcm-dev
# 운영: 서비스 계정 JSON을 base64로 인코딩해 배포 플랫폼 환경변수에 등록 (파일·저장소에 두지 않음)
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# 로컬 에뮬레이터 사용 시(firebase emulators:start) — 운영에서는 비워 둘 것
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── AI 추천 ───
# mock | gemini | claude | openai  (비교 후 1종 선정, 어댑터만 교체)
AI_PROVIDER=mock
AI_API_KEY=
# 선정한 제공사의 공식 문서에서 최신 모델명을 확인해 입력 (claude 기본값: claude-haiku-5-5)
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_DAILY_LIMIT=10
# 대체 추천 테스트: true면 mock이 실패를 흉내냄
AI_MOCK_FAIL=false

# ─── 기타 ───
LOG_HASH_SALT=change-me
# 개발·테스트에서만: X-Debug-Today 헤더로 '오늘' 날짜를 바꿔 재배분 검증
ALLOW_DEBUG_TODAY=false
