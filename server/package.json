{
  "name": "jcm-server",
  "version": "0.1.0",
  "private": true,
  "description": "정처기메이트 Express REST API 서버",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test jest --coverage",
    "seed": "node scripts/seed.js",
    "seed:test-users": "node scripts/seed.js --test-users",
    "set-admin": "node scripts/setAdmin.js",
    "export-masters": "node scripts/exportMasters.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/services/scheduler.js", "src/services/weakness.js", "src/services/progressCalc.js", "src/services/materialLogic.js", "src/lib/**/*.js"]
  }
}
